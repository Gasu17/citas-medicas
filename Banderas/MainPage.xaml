<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Banderas.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <CollectionView x:Name="listaPaises"
                            SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".2*" />
                                <ColumnDefinition Width=".8*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding bandera}" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding nombre}" FontAttributes="Bold" FontSize="Large" />
                                <Label Text="{Binding capital}" FontAttributes="Italic" IsVisible="False" />
                       
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Entry x:Name="entryCapital" Text="Introduce la capital" />
            <Button Text="Comprobar" Clicked="ComprobarCapital" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>